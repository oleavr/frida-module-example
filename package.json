{
  "name": "frida-module-example",
  "version": "1.1.0",
  "description": "Example Frida module written in TypeScript",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile --library lib/index.ts -o dist",
    "watch": "frida-compile --library -w lib/index.ts -o dist"
  },
  "devDependencies": {
    "frida-compile": "^19.1.0"
  }
}
